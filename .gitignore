.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run outputs and generated reports
runs/
reports/figures/
reports/tables/

# SWE-bench harness writes here relative to CWD; contains gold patches and
# oracle test output, so it must never be committed. The Phase 8.3 leakage
# audit has to cover this path as well as runs/.
logs/

# Prediction and trajectory files. Ignored by extension as well as by location,
# because a stray predictions file outside runs/ would otherwise be committable
# and these can carry gold patches.
*.jsonl

# Docker bind-mount and volume scratch space used by the evaluation harness.
.docker/
docker-volumes/

# Frozen patch artifacts are recorded in run directories, never at the repo root.
*.patch
*.diff

# call-graph raw outputs (regenerable)
reports/callgraph_selection/graphs/
reports/callgraph_selection/provenance/

# Local call-graph intermediates; final summaries and manifests stay tracked.
/reports/callgraph_selection/amendment2_72ad21b/graphs/
/reports/callgraph_selection/followup_cache/
/reports/callgraph_selection/phase2/failed_attempts/
/reports/callgraph_selection/phase2/ranked_outputs.jsonl.gz
/reports/callgraph_selection/phase2/per_test_provenance.csv
/reports/callgraph_selection/**/*.log
