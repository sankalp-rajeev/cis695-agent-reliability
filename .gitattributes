# Source and text files are LF in the repository and LF in the working tree.
# This project runs its harness inside Linux containers from a WSL2 checkout, and
# a CRLF shell script fails at runtime ("set: pipefail: invalid option name"), so
# LF is enforced explicitly rather than left to core.autocrlf. Editors on the
# Windows side have rewritten files as CRLF on save, which is what this prevents.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
*.tsv  text eol=lf

# Frozen patch artifacts are byte-exact evidence. Line-ending conversion would
# corrupt them and invalidate patch-application and integrity verification.
# These must follow the general rule above so that they win as the later match.
*.patch -text
*.diff -text

# Trajectories and records are compared across runs; keep them byte-stable too.
*.jsonl -text

# Binary documents carry no line endings and must never be normalised.
*.pptx binary
*.png  binary
*.pdf  binary

# Preserve whitespace in these exact frozen evidence and implementation files.
reports/v2_scoring_audit/resume_20261026/phase2/pylint-dev__pylint-6528/base/initial/runner.raw whitespace=-blank-at-eol
reports/v2_scoring_audit/resume_20261026/phase2/pytest-dev__pytest-5809/base/initial/batch_0001.raw whitespace=-blank-at-eof
src/reliability/verifier/superseded_shadow_v2.py whitespace=-blank-at-eof
reports/next_steps/report.md whitespace=-blank-at-eol

# Fresh V2 runner captures are byte-exact evidence, including CRLF and whitespace.
reports/v2_discovery_cleanup/**/*.raw -text whitespace=-blank-at-eol,-blank-at-eof
reports/v2_discovery_cleanup/frozen_83/patches/*.patch -text whitespace=-blank-at-eol,-blank-at-eof
reports/v2_discovery_cleanup/frozen_83/issues/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

