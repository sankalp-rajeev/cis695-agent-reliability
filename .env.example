# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Keys are read from the environment at call time and are never written to run
# records, logs, or trajectories. See src/reliability/config.py.

# Model access. Only the provider actually named in configs/model/*.yaml is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: raises Hugging Face Hub rate limits when loading SWE-bench Verified.
# The dataset is public, so this is a convenience, not a requirement.
HF_TOKEN=

# Optional: overrides the default Docker socket if not /var/run/docker.sock.
# DOCKER_HOST=
